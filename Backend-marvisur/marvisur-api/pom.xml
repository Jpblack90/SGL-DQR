<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ====================================================
         POM marvisur-api — API REST Spring Boot (ESQUELETO)
         Spring Boot 3 · JPA · Flyway · PostgreSQL
         CORE-01: Solo esqueleto vacío, sin código fuente aún.
         Implementación completa en API-01 a API-07.
         ==================================================== -->
    <parent>
        <groupId>pe.marvisur</groupId>
        <artifactId>marvisur-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>marvisur-api</artifactId>
    <packaging>jar</packaging>

    <name>Marvisur API</name>
    <description>Adaptador REST Spring Boot 3 para el sistema SGL-DQR (pendiente implementación API-01 a API-07)</description>

    <dependencies>

        <!-- Núcleo de dominio (arquitectura hexagonal) -->
        <dependency>
            <groupId>pe.marvisur</groupId>
            <artifactId>marvisur-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot Web (REST API) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>3.3.5</version>
        </dependency>

        <!-- Spring Data JPA (ORM adaptador PostgreSQL) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <version>3.3.5</version>
        </dependency>

        <!-- PostgreSQL JDBC Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.4</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway — Migraciones de base de datos -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>10.20.1</version>
        </dependency>

        <!-- Spring Boot Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>3.3.5</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>

