# ============================================================
# .env.example — Variables de Entorno del Sistema SGL-DQR
# Copia este archivo como '.env' y completa con tus credenciales reales.
# ============================================================

# ------------------------------------------------------------
# 1. Base de Datos PostgreSQL
# ------------------------------------------------------------
POSTGRES_DB=marvisur_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# URL de conexión para Spring Boot
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/marvisur_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# ------------------------------------------------------------
# 2. Seguridad y JWT (JSON Web Token)
# REQUISITO CRÍTICO: Debe ser una cadena de al menos 256 bits (32 bytes).
# En perfil 'prod', la aplicación NO iniciará si este valor no está configurado.
#
# Comandos para generar un secreto criptográficamente seguro:
# - Linux / macOS:
#     openssl rand -base64 32
# - Windows PowerShell:
#     [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
# ------------------------------------------------------------
JWT_SECRET=reemplazar_con_clave_generada_aleatoriamente_de_al_menos_256_bits_longitud_minima_segura

# ------------------------------------------------------------
# 3. CORS (Orígenes Permitidos)
# Lista separada por comas de orígenes frontend autorizados
# ------------------------------------------------------------
CORS_ORIGENES=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------
# 4. Portal Web y Billetera Digital
# URL base para los enlaces de billetera generados en el comprobante (/billetera#<token>)
# ------------------------------------------------------------
APP_PORTAL_URL_BASE=http://localhost:5173
