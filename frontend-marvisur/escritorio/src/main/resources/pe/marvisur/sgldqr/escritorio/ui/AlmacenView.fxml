<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import pe.marvisur.sgldqr.escritorio.ui.componentes.CampoEscaneo?>

<TabPane fx:id="tabPaneAlmacen" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="pe.marvisur.sgldqr.escritorio.ui.ControladorAlmacen"
         tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: transparent;">

    <!-- =================================================================== -->
    <!-- PESTAÑA 1: VALIDACIÓN CRUZADA Y ENTREGA FÍSICA -->
    <!-- =================================================================== -->
    <Tab fx:id="tabEntrega" text="Entrega (Doble QR)">
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="16" style="-fx-padding: 20;">
                <VBox spacing="2">
                    <Label text="Validación Cruzada y Entrega Física (RF-07)"
                           style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #0F172A;"/>
                    <Label text="Escanee el QR1 operativo del bulto y el QR2 digital del cliente para autorizar la entrega."
                           style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                </VBox>

                <HBox spacing="16">
                    <!-- TARJETA ESCANEO QR1 Y QR2 -->
                    <VBox spacing="12" styleClass="tarjeta" prefWidth="500">
                        <Label text="Escaneo de Códigos" styleClass="tarjeta-titulo"/>

                        <VBox spacing="4">
                            <Label text="QR1 Físico (Bulto):" styleClass="label-campo"/>
                            <CampoEscaneo fx:id="txtQr1Entrega" promptText="Escanear o ingresar código QR1 del bulto..."/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="QR2 Digital (Billetera del Cliente):" styleClass="label-campo"/>
                            <CampoEscaneo fx:id="txtQr2Entrega" promptText="Escanear o ingresar llave digital QR2..."/>
                        </VBox>

                        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 8 0 0 0;">
                            <Button fx:id="btnLimpiarEntrega" text="Limpiar" onAction="#limpiarEntrega"
                                    styleClass="btn-secundario"/>
                            <Button fx:id="btnValidarEntrega" text="Validar Entrega Física" onAction="#manejarValidarEntrega"
                                    styleClass="btn-primario"/>
                        </HBox>
                    </VBox>

                    <!-- PANEL DE RESULTADOS (DINÁMICO) -->
                    <VBox fx:id="panelResultadoEntrega" spacing="12" styleClass="tarjeta" HBox.hgrow="ALWAYS"
                          visible="false" managed="false">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label fx:id="lblTituloResultadoEntrega" text="Resultado de Validación"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblLatenciaEntrega" text="15 ms" styleClass="badge-sucursal"/>
                        </HBox>

                        <Separator/>

                        <VBox spacing="8">
                            <Label fx:id="lblMensajeResultadoEntrega" text="Mensaje descriptivo..." wrapText="true"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                            <Label fx:id="lblDetalleComprobanteEntrega" text="Comprobante: --"
                                   style="-fx-font-size: 13px; -fx-text-fill: #0F172A;"/>
                            <Label fx:id="lblMontoPendienteEntrega" text="Monto Pendiente: S/ 0.00"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #B45309;"
                                   visible="false" managed="false"/>
                        </VBox>

                        <!-- Acciones tras bloqueo por pago pendiente -->
                        <HBox fx:id="panelAccionCobroEntrega" spacing="10" alignment="CENTER_LEFT"
                              visible="false" managed="false" style="-fx-padding: 8 0 0 0;">
                            <Button fx:id="btnCobrarEntrega" text="Registrar Cobro en Almacén" onAction="#manejarCobroContraEntrega"
                                    styleClass="btn-exito"/>
                            <Button fx:id="btnReintentarValidacion" text="Reintentar Validación" onAction="#manejarReintentarValidacion"
                                    styleClass="btn-primario" disable="true"/>
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </Tab>

    <!-- =================================================================== -->
    <!-- PESTAÑA 2: PROCESAMIENTO MASIVO DE LOTES -->
    <!-- =================================================================== -->
    <Tab fx:id="tabLotes" text="Lotes de Escaneo">
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="16" style="-fx-padding: 20;">
                <VBox spacing="2">
                    <Label text="Procesamiento Masivo por Lotes (RF-06)"
                           style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #0F172A;"/>
                    <Label text="Recepción masiva en origen, despacho a viajes interprovinciales y recepción en destino."
                           style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                </VBox>

                <!-- PARÁMETROS DEL LOTE -->
                <HBox spacing="16">
                    <VBox spacing="10" styleClass="tarjeta" prefWidth="480">
                        <Label text="Configuración del Lote" styleClass="tarjeta-titulo"/>

                        <VBox spacing="4">
                            <Label text="Acción Operativa:" styleClass="label-campo"/>
                            <ComboBox fx:id="cmbAccionLote" maxWidth="Infinity"/>
                        </VBox>

                        <VBox fx:id="contenedorViajeLote" spacing="4" visible="false" managed="false">
                            <Label text="Viaje Programado de Despacho:" styleClass="label-campo"/>
                            <ComboBox fx:id="cmbViajeLote" maxWidth="Infinity" promptText="Seleccione viaje..."/>
                        </VBox>

                        <Separator/>

                        <VBox spacing="4">
                            <Label text="Escanear QR1 (Enter para agregar):" styleClass="label-campo"/>
                            <CampoEscaneo fx:id="txtQr1Lote" promptText="Escanear QR1 operativo del bulto..."/>
                        </VBox>

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label fx:id="lblContadorLote" text="Total escaneados: 0"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #E30613;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnQuitarItemLote" text="Quitar" onAction="#quitarItemLote"
                                    styleClass="btn-secundario" style="-fx-font-size: 11px;"/>
                            <Button fx:id="btnLimpiarListaLote" text="Limpiar" onAction="#limpiarListaLote"
                                    styleClass="btn-secundario" style="-fx-font-size: 11px;"/>
                        </HBox>

                        <Button fx:id="btnProcesarLote" text="Procesar Lote de Escaneo" onAction="#manejarProcesarLote"
                                maxWidth="Infinity" styleClass="btn-primario"/>
                    </VBox>

                    <!-- TABLA DE ITEMS ESCANEADOS EN COLA -->
                    <VBox spacing="8" styleClass="tarjeta" HBox.hgrow="ALWAYS">
                        <Label text="Códigos QR1 en Cola de Lote" styleClass="tarjeta-titulo"/>
                        <ListView fx:id="listaEscaneoLote" prefHeight="220"/>
                    </VBox>
                </HBox>

                <!-- RESULTADOS DEL LOTE -->
                <VBox fx:id="panelResultadoLote" spacing="12" styleClass="tarjeta" visible="false" managed="false">
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <Label text="Resumen de Procesamiento del Lote"
                               style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblResumenTotal" text="Total: 0" styleClass="badge-sucursal"/>
                        <Label fx:id="lblResumenExitosos" text="Exitosos: 0" styleClass="badge-pagado"/>
                        <Label fx:id="lblResumenYaRegistrados" text="Ya Registrados: 0" styleClass="badge-sucursal"/>
                        <Label fx:id="lblResumenErrores" text="Errores: 0" styleClass="badge-pendiente"/>
                    </HBox>

                    <TableView fx:id="tablaResultadoLote" prefHeight="200">
                        <columns>
                            <TableColumn fx:id="colLoteQr1" text="Código QR1" prefWidth="250"/>
                            <TableColumn fx:id="colLoteResultado" text="Resultado" prefWidth="120"/>
                            <TableColumn fx:id="colLoteMotivo" text="Motivo / Detalle" prefWidth="300"/>
                        </columns>
                    </TableView>

                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button fx:id="btnReintentarFallidos" text="Reintentar solo fallidos" onAction="#reintentarSoloFallidos"
                                styleClass="btn-primario"/>
                        <Button fx:id="btnExportarCsv" text="Exportar a CSV" onAction="#exportarResultadoLoteCsv"
                                styleClass="btn-secundario"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </Tab>

    <!-- =================================================================== -->
    <!-- PESTAÑA 3: CONTINGENCIA, BÚSQUEDA DNI/RUC E INCIDENCIAS -->
    <!-- =================================================================== -->
    <Tab fx:id="tabContingencia" text="Contingencia e Incidencias">
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="16" style="-fx-padding: 20;">
                <VBox spacing="2">
                    <Label text="Módulo de Contingencia y Búsqueda de Emergencia (RF-06)"
                           style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #0F172A;"/>
                    <Label text="Localice encomiendas por DNI/RUC cuando la etiqueta física esté dañada, registre cobros o regenere el QR1."
                           style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                </VBox>

                <!-- BUSCADOR -->
                <HBox spacing="10" alignment="CENTER_LEFT" styleClass="tarjeta">
                    <Label text="Documento Remitente o Destinatario:" styleClass="label-campo"/>
                    <TextField fx:id="txtBusquedaDoc" promptText="DNI (8 dígitos) o RUC (11 dígitos)" prefWidth="240"/>
                    <Button fx:id="btnBuscarDoc" text="Buscar Encomiendas" onAction="#manejarBuscarPorDocumento"
                            styleClass="btn-primario" defaultButton="true"/>
                </HBox>

                <!-- TABLA RESULTADOS DE BÚSQUEDA -->
                <VBox spacing="8" styleClass="tarjeta">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Resultados de Búsqueda" styleClass="tarjeta-titulo"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Seleccione una fila para gestionar cobro o incidencias"
                               style="-fx-font-size: 11px; -fx-text-fill: #64748B;"/>
                    </HBox>

                    <TableView fx:id="tablaBusquedaEncomiendas" prefHeight="180">
                        <columns>
                            <TableColumn fx:id="colBusqComprobante" text="Comprobante" prefWidth="130"/>
                            <TableColumn fx:id="colBusqRemitente" text="Remitente" prefWidth="160"/>
                            <TableColumn fx:id="colBusqDestinatario" text="Destinatario" prefWidth="160"/>
                            <TableColumn fx:id="colBusqDestino" text="Destino" prefWidth="90"/>
                            <TableColumn fx:id="colBusqPeso" text="Peso (Kg)" prefWidth="80"/>
                            <TableColumn fx:id="colBusqTotal" text="Total (S/.)" prefWidth="90"/>
                            <TableColumn fx:id="colBusqEstadoPago" text="Pago" prefWidth="100"/>
                            <TableColumn fx:id="colBusqEstadoLogistico" text="Estado Logístico" prefWidth="130"/>
                        </columns>
                    </TableView>

                    <!-- BARRA DE ACCIÓN PARA FILA SELECCIONADA -->
                    <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 6 0 0 0;">
                        <Button fx:id="btnCobroContingencia" text="Registrar Cobro Pendiente" onAction="#manejarCobroContingencia"
                                styleClass="btn-exito" disable="true"/>
                        <Button fx:id="btnAbrirReportarIncidencia" text="Reportar Incidencia de Etiqueta" onAction="#abrirFormularioIncidencia"
                                styleClass="btn-secundario" disable="true"/>
                    </HBox>
                </VBox>

                <!-- SECCIÓN REPORTE DE INCIDENCIA / REGENERACIÓN QR1 -->
                <HBox fx:id="panelIncidencia" spacing="16" visible="false" managed="false">
                    <VBox spacing="10" styleClass="tarjeta" prefWidth="450">
                        <Label text="Reportar Etiqueta Dañada o Perdida" styleClass="tarjeta-titulo"/>

                        <VBox spacing="4">
                            <Label text="Tipo de Incidencia:" styleClass="label-campo"/>
                            <ComboBox fx:id="cmbTipoIncidencia" maxWidth="Infinity"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Motivo / Justificación de Reimpresión:" styleClass="label-campo"/>
                            <TextArea fx:id="txtMotivoIncidencia" promptText="Describa el motivo del deterioro o pérdida..."
                                      prefRowCount="3"/>
                        </VBox>

                        <HBox spacing="10" alignment="CENTER_RIGHT">
                            <Button text="Cancelar" onAction="#cerrarPanelIncidencia" styleClass="btn-secundario"/>
                            <Button fx:id="btnConfirmarIncidencia" text="Registrar y Regenerar QR1" onAction="#manejarRegistrarIncidencia"
                                    styleClass="btn-primario"/>
                        </HBox>
                    </VBox>

                    <!-- QR1 REGENERADO -->
                    <VBox fx:id="panelQr1Regenerado" spacing="8" alignment="CENTER" styleClass="tarjeta" prefWidth="250"
                          visible="false" managed="false">
                        <Label text="QR1 Operativo Regenerado" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                        <ImageView fx:id="imgQr1Regenerado" fitWidth="140" fitHeight="140" preserveRatio="true"/>
                        <Button fx:id="btnImprimirEtiquetaRegenerada" text="Imprimir Etiqueta" onAction="#imprimirQr1Regenerado"
                                styleClass="btn-exito" style="-fx-font-size: 11px;"/>
                    </VBox>

                    <!-- HISTORIAL DE INCIDENCIAS DE LA ENCOMIENDA -->
                    <VBox spacing="6" styleClass="tarjeta" HBox.hgrow="ALWAYS">
                        <Label text="Historial de Incidencias de la Encomienda" styleClass="tarjeta-titulo"/>
                        <TableView fx:id="tablaHistorialIncidencias" prefHeight="130">
                            <columns>
                                <TableColumn fx:id="colIncTipo" text="Tipo" prefWidth="120"/>
                                <TableColumn fx:id="colIncMotivo" text="Motivo" prefWidth="180"/>
                                <TableColumn fx:id="colIncFecha" text="Fecha" prefWidth="130"/>
                            </columns>
                        </TableView>
                    </VBox>
                </HBox>

            </VBox>
        </ScrollPane>
    </Tab>

</TabPane>
