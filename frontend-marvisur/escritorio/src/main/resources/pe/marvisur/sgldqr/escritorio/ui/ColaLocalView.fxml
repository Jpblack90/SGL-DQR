<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.marvisur.sgldqr.escritorio.ui.ControladorColaLocal"
      spacing="16" style="-fx-padding: 24; -fx-background-color: #F8FAFC;">

    <!-- CABECERA -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="COLA LOCAL DE REGISTROS SIN CONEXIÓN"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
            <Label text="Gestión de encomiendas emitidas offline en SQLite y estado de sincronización centralizada (O1, O2)."
                   style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
        </VBox>

        <!-- ACCIONES -->
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button fx:id="btnRefrescar" text="Actualizar" onAction="#cargarDatos"
                    styleClass="btn-secundario"/>
            <Button fx:id="btnReintentarErrores" text="Reintentar Errores" onAction="#manejarReintentarErrores"
                    style="-fx-background-color: #F59E0B; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6;"/>
            <Button fx:id="btnSincronizarAhora" text="Sincronizar Ahora" onAction="#manejarSincronizarAhora"
                    styleClass="btn-primario"/>
        </HBox>
    </HBox>

    <!-- TARJETAS DE RESUMEN -->
    <HBox spacing="16">
        <HBox spacing="10" alignment="CENTER_LEFT"
              style="-fx-background-color: white; -fx-padding: 12 16; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;"
              HBox.hgrow="ALWAYS">
            
            <VBox spacing="2">
                <Label text="Pendientes de Envío" style="-fx-font-size: 11px; -fx-text-fill: #64748B;"/>
                <Label fx:id="lblTotalPendientes" text="0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #D97706;"/>
            </VBox>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT"
              style="-fx-background-color: white; -fx-padding: 12 16; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;"
              HBox.hgrow="ALWAYS">
            
            <VBox spacing="2">
                <Label text="Sincronizadas Exitosas" style="-fx-font-size: 11px; -fx-text-fill: #64748B;"/>
                <Label fx:id="lblTotalSincronizadas" text="0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #16A34A;"/>
            </VBox>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT"
              style="-fx-background-color: white; -fx-padding: 12 16; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;"
              HBox.hgrow="ALWAYS">
            
            <VBox spacing="2">
                <Label text="Con Error de Sincronización" style="-fx-font-size: 11px; -fx-text-fill: #64748B;"/>
                <Label fx:id="lblTotalErrores" text="0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #DC2626;"/>
            </VBox>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT"
              style="-fx-background-color: white; -fx-padding: 12 16; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;"
              HBox.hgrow="ALWAYS">
            
            <VBox spacing="2">
                <Label text="Total en Base Local" style="-fx-font-size: 11px; -fx-text-fill: #64748B;"/>
                <Label fx:id="lblTotalRegistros" text="0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
            </VBox>
        </HBox>
    </HBox>

    <!-- TABLA DE LA COLA LOCAL -->
    <VBox spacing="8" VBox.vgrow="ALWAYS"
          style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">

        <Label text="Registros en SQLite (marvisur-local.db)"
               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>

        <TableView fx:id="tablaColaLocal" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID Encomienda (UUID)" prefWidth="250"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
                <TableColumn fx:id="colIntentos" text="Intentos" prefWidth="70"/>
                <TableColumn fx:id="colCreadoEn" text="Fecha Creación" prefWidth="150"/>
                <TableColumn fx:id="colActualizadoEn" text="Última Actualización" prefWidth="150"/>
                <TableColumn fx:id="colUltimoError" text="Último Error / Detalle" prefWidth="280"/>
            </columns>
            <placeholder>
                <Label text="No hay registros en la cola local SQLite." style="-fx-text-fill: #94A3B8;"/>
            </placeholder>
        </TableView>

        <!-- PIE DE TABLA -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label fx:id="lblEstadoSincronizacion" text="Sincronizador en segundo plano activo (sondeo cada 10 s)."
                   style="-fx-font-size: 11px; -fx-text-fill: #64748B;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="* Cero secretos: el archivo SQLite almacena exclusivamente hashes SHA-256."
                   style="-fx-font-size: 11px; -fx-text-fill: #94A3B8; -fx-font-style: italic;"/>
        </HBox>
    </VBox>

</VBox>
