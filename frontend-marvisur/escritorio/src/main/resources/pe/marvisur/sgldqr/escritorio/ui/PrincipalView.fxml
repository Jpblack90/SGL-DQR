<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.marvisur.sgldqr.escritorio.ui.ControladorPrincipal"
            prefWidth="1100" prefHeight="700">

    <!-- BARRA SUPERIOR -->
    <top>
        <HBox styleClass="barra-superior" spacing="16" alignment="CENTER_LEFT">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Circle radius="9" fill="#E30613"/>
                <Label text="EXPRESO MARVISUR · SGL-DQR" styleClass="titulo-app"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Indicador de conectividad centralizada (Health Polling cada 5s) -->
            <HBox alignment="CENTER" spacing="6" style="-fx-padding: 0 10;">
                <Circle fx:id="circuloConexion" radius="5" fill="#10B981"/>
                <Label fx:id="lblEstadoConexion" text="En línea"
                       style="-fx-text-fill: #E2E8F0; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                <Label fx:id="lblPendientes" text="Pendientes: 0" visible="false" managed="false"
                       style="-fx-text-fill: #F59E0B; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-color: #78350F; -fx-padding: 2 6; -fx-background-radius: 4;"/>
            </HBox>

            <!-- Datos del Colaborador -->
            <Label fx:id="lblSucursal" text="Agencia: SUC-LIM-01" styleClass="badge-sucursal"/>
            <Label fx:id="lblUsuario" text="Colaborador" styleClass="badge-usuario"/>
            <Label fx:id="lblRol" text="TN1" styleClass="badge-sucursal"/>

            <!-- Botón Cerrar Sesión -->
            <Button fx:id="btnCerrarSesion" text="Salir" onAction="#manejarCerrarSesion"
                    styleClass="btn-secundario" style="-fx-font-size: 11px; -fx-padding: 4 10;"/>
        </HBox>
    </top>

    <!-- MENÚ LATERAL -->
    <left>
        <VBox styleClass="menu-lateral" spacing="6">
            <Label text="OPERACIONES"
                   style="-fx-text-fill: #94A3B8; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 6 10;"/>

            <Button fx:id="btnMenuVentanilla" text="📦 Ventanilla" onAction="#mostrarVentanilla"
                    styleClass="boton-menu"/>
            <Button fx:id="btnMenuAlmacen" text="🏬 Almacén" onAction="#mostrarAlmacen"
                    styleClass="boton-menu"/>
            <Button fx:id="btnMenuContingencia" text="🚨 Contingencia" onAction="#mostrarContingencia"
                    styleClass="boton-menu"/>
            <Button fx:id="btnMenuColaLocal" text="📋 Cola Local" onAction="#mostrarColaLocal"
                    styleClass="boton-menu"/>
            <Button fx:id="btnMenuRutas" text="🚚 Rutas / Flota (Próx.)" onAction="#mostrarAvisoProximamente"
                    styleClass="boton-menu, boton-menu-deshabilitado"/>

            <Separator style="-fx-background-color: #334155; -fx-padding: 6 0;"/>

            <Label text="GESTIÓN"
                   style="-fx-text-fill: #94A3B8; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 6 10;"/>

            <Button fx:id="btnMenuDashboard" text="📊 Dashboard" onAction="#mostrarDashboard"
                    styleClass="boton-menu"/>
            <Button fx:id="btnMenuEmpleados" text="👥 Empleados (Próx.)" onAction="#mostrarAvisoProximamente"
                    styleClass="boton-menu, boton-menu-deshabilitado"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox alignment="CENTER" spacing="2" style="-fx-padding: 8;">
                <Label text="SGL-DQR v1.0.0" style="-fx-text-fill: #64748B; -fx-font-size: 10px;"/>
                <Label text="Expreso Marvisur S.A." style="-fx-text-fill: #475569; -fx-font-size: 9px;"/>
            </VBox>
        </VBox>
    </left>

    <!-- ÁREA DE TRABAJO PRINCIPAL -->
    <center>
        <StackPane fx:id="contenedorContenido" style="-fx-background-color: #F8FAFC;">
            <!-- El contenido se carga dinámicamente aquí -->
        </StackPane>
    </center>

</BorderPane>
