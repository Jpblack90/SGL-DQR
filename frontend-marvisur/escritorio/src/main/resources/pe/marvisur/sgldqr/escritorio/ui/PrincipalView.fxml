<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.marvisur.sgldqr.escritorio.ui.ControladorPrincipal"
            prefHeight="720.0" prefWidth="1100.0"
            style="-fx-background-color: #F8FAFC;">

    <!-- BARRA SUPERIOR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="barra-superior">
            <Label text="EXPRESO MARVISUR" styleClass="titulo-app"/>
            <Label text="SGL-DQR · Ventanilla y Almacén" style="-fx-text-fill: #94A3B8; -fx-font-size: 13px;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Indicador de conectividad central (ServicioConexion) -->
            <HBox fx:id="panelConectividad" alignment="CENTER" spacing="6"
                  style="-fx-background-color: #0F172A; -fx-padding: 4 10; -fx-background-radius: 12;">
                <Circle fx:id="indicadorConexion" radius="5" styleClass="estado-online"/>
                <Label fx:id="lblEstadoConexion" text="En línea"
                       style="-fx-text-fill: #E2E8F0; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                <Label fx:id="lblPendientes" text="(0 pend.)"
                       style="-fx-text-fill: #F59E0B; -fx-font-size: 11px; -fx-font-weight: bold;"
                       visible="false" managed="false"/>
            </HBox>

            <Label fx:id="lblSucursal" text="Agencia Lima Central" styleClass="badge-sucursal"/>
            <Label fx:id="lblUsuario" text="TN1 · Juan Pérez" styleClass="badge-usuario"/>
            <Button text="Cerrar Sesión" onAction="#cerrarSesion" styleClass="btn-secundario"
                    style="-fx-font-size: 11px; -fx-padding: 4 10;"/>
        </HBox>
    </top>

    <!-- MENÚ LATERAL IZQUIERDO -->
    <left>
        <VBox spacing="4" styleClass="menu-lateral">
            <Label text="OPERACIONES"
                   style="-fx-text-fill: #94A3B8; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 6 10;"/>

            <Button fx:id="btnMenuVentanilla" text="📦 Ventanilla" onAction="#mostrarVentanilla"
                    styleClass="boton-menu, boton-menu-activo"/>
            <Button fx:id="btnMenuAlmacen" text="🏬 Almacén" onAction="#mostrarAlmacen"
                    styleClass="boton-menu"/>
            <Button fx:id="btnMenuContingencia" text="🚨 Contingencia" onAction="#mostrarContingencia"
                    styleClass="boton-menu"/>
            <Button fx:id="btnMenuColaLocal" text="📋 Cola Local" onAction="#mostrarColaLocal"
                    styleClass="boton-menu"/>
            <Button fx:id="btnMenuRutas" text="🚚 Rutas / Flota (Próx.)" onAction="#mostrarAvisoProximamente"
                    styleClass="boton-menu, boton-menu-deshabilitado"/>

            <Separator style="-fx-background-color: #334155; -fx-padding: 6 0;"/>

            <Label text="GESTIÓN"
                   style="-fx-text-fill: #94A3B8; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 6 10;"/>

            <Button fx:id="btnMenuDashboard" text="📊 Dashboard" onAction="#mostrarDashboard"
                    styleClass="boton-menu"/>
            <Button fx:id="btnMenuEmpleados" text="👥 Empleados" onAction="#mostrarEmpleados"
                    styleClass="boton-menu"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox alignment="CENTER" spacing="2" style="-fx-padding: 8;">
                <Label text="SGL-DQR v1.0.0" style="-fx-text-fill: #64748B; -fx-font-size: 10px;"/>
                <Label text="Expreso Marvisur S.A." style="-fx-text-fill: #475569; -fx-font-size: 9px;"/>
            </VBox>
        </VBox>
    </left>

    <!-- ÁREA DE TRABAJO PRINCIPAL -->
    <center>
        <StackPane fx:id="contenedorContenido" style="-fx-background-color: #F8FAFC;">
            <!-- El contenido se carga dinámicamente aquí -->
        </StackPane>
    </center>

</BorderPane>
