# Ejemplo de configuración de la API en Ubuntu Server.
# instalar.sh crea deploy/ubuntu/api.env con estos valores la primera vez
# (permiso 600). api.env no se sube a git.
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/marvisur_db
SPRING_DATASOURCE_USERNAME=marvisur
SPRING_DATASOURCE_PASSWORD=marvisur_dev
APP_PORTAL_URL_BASE=http://localhost:8088
CORS_ORIGENES=http://localhost:8088
