<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://justflow.it/bpmn" exporter="Just Flow It" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_encomiendas" name="Recepción y Entrega de Encomiendas" processRef="Process_pool_encomiendas" />
  </bpmn:collaboration>
  <bpmn:process id="Process_pool_encomiendas" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="lane_remitente" name="Remitente">
        <bpmn:flowNodeRef>start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_entregar_ventanilla</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_recepcionista" name="Recepcionista">
        <bpmn:flowNodeRef>task_registrar_sistema</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_calcular_tarifa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_entregar_comprobante</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_almacenero" name="Almacenero">
        <bpmn:flowNodeRef>task_trasladar_paquete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_verificar_pago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_entregar_paquete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_destinatario" name="Destinatario">
        <bpmn:flowNodeRef>task_presentar_comprobante</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_1" />
    <bpmn:manualTask id="task_entregar_ventanilla" name="Entregar el paquete en ventanilla" />
    <bpmn:userTask id="task_registrar_sistema" name="Registrar vía sistema central" />
    <bpmn:manualTask id="task_calcular_tarifa" name="Calcular tarifa y modalidad de pago" />
    <bpmn:manualTask id="task_entregar_comprobante" name="Entregar comprobante físico de papel" />
    <bpmn:manualTask id="task_trasladar_paquete" name="Trasladar paquete sin validación digital" />
    <bpmn:userTask id="task_verificar_pago" name="Verificar pago llamando a la Central" />
    <bpmn:manualTask id="task_entregar_paquete" name="Entregar el paquete" />
    <bpmn:endEvent id="end_1" />
    <bpmn:manualTask id="task_presentar_comprobante" name="Presentar comprobante físico" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="start_1" targetRef="task_entregar_ventanilla" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_entregar_ventanilla" targetRef="task_registrar_sistema" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="task_registrar_sistema" targetRef="task_calcular_tarifa" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_calcular_tarifa" targetRef="task_entregar_comprobante" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_entregar_comprobante" targetRef="task_trasladar_paquete" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_trasladar_paquete" targetRef="task_presentar_comprobante" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="task_verificar_pago" targetRef="task_entregar_paquete" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="task_entregar_paquete" targetRef="end_1" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="task_presentar_comprobante" targetRef="task_verificar_pago" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
