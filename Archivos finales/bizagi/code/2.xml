      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Operativo_di" bpmnElement="Lane_Operativo" isHorizontal="true">
        <dc:Bounds x="180" y="225" width="1020" height="125" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_PM_di" bpmnElement="Lane_PM" isHorizontal="true">
