      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_task_invalidar_liberar" bpmnElement="task_invalidar_liberar">
        <dc:Bounds x="1455" y="909" width="104" height="65" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_end_sgl" bpmnElement="end_sgl">
        <dc:Bounds x="1640" y="924" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_lane_almacenero" bpmnElement="lane_almacenero">
